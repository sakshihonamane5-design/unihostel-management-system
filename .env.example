# Copy this file to .env in the project root for local development.
# Never commit a real .env file.

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (tests use an in-memory database).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/unihostel?retryWrites=true&w=majority

# JWT signing secret — use a long random value in any shared environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Cookie settings
COOKIE_NAME=unihostel_token
COOKIE_SECURE=false

# Password reset tokens expire after this many minutes.
PASSWORD_RESET_MINUTES=60

# Demo seed passwords — used only by `npm run seed`. Do not reuse in production.
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!
SEED_SECURITY_PASSWORD=ChangeMe_Gate_123!
SEED_MENTOR_PASSWORD=ChangeMe_Mentor_123!
SEED_STUDENT_PASSWORD=ChangeMe_Student_123!
